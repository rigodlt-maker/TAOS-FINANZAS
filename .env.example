# Supabase (sin estas tres la app corre en modo demostración)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Único correo con acceso a la app (y destino de los correos)
ALLOWED_EMAIL=tu@correo.com

# Protege las rutas de los crons. Genera uno con: https://generate-secret.vercel.app/32
CRON_SECRET=

# Correos (https://resend.com, plan gratuito)
RESEND_API_KEY=

# Opcional: activa la IA (lectura de PDF, categorización y consejos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
